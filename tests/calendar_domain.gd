extends SceneTree

const Date = preload("res://rookframe/packages/aae579da-5392-4507-8eaa-0d918af58076/logic/gregorian_date.gd")
const CalendarData = preload("res://rookframe/packages/aae579da-5392-4507-8eaa-0d918af58076/logic/calendar_data.gd")

func _initialize() -> void:
	var date := Date.new()
	for pair in [["2024-02-28", "2024-02-29"], ["2024-02-29", "2024-03-01"], ["1900-02-28", "1900-03-01"], ["2000-02-28", "2000-02-29"], ["2023-12-31", "2024-01-01"]]:
		assert(date.read_iso(pair[0]))
		assert(date.advance_day())
		assert(date.iso() == pair[1])
	assert(date.read_iso("9999-12-31"))
	assert(not date.advance_day())
	assert(date.iso() == "9999-12-31")
	for invalid in ["0000-01-01", "10000-01-01", "2023-02-29", "2024-04-31", "2024-13-01", "2024-2-01", "+2024-02-01"]:
		assert(not date.read_iso(invalid), "Accepted invalid date: " + invalid)
	var calendar := CalendarData.new()
	assert(calendar.read(null))
	assert(not calendar.initialized)
	assert(not calendar.advance_day())
	assert(calendar.set_date("2024-02-28"))
	var id := calendar.create_note("2024-02-28", "Arrival", "At the harbor")
	assert(id == 1)
	assert(calendar.create_note("2024-02-29", "Leap day", "Festival") == 2)
	assert(calendar.notes_for("2024-02-28").size() == 1)
	assert(calendar.update_note(id, "2024-02-28", "Arrival changed", "At the inn"))
	assert(calendar.notes_for("2024-02-28")[0].body == "At the inn")
	var before: Variant = calendar.to_value()
	assert(not calendar.set_date("2023-02-29"))
	assert(not calendar.update_note(999, "2024-02-28", "Missing", "Unknown"))
	assert(calendar.create_note("2024-02-30", "Invalid", "Date") == 0)
	assert(calendar.to_value() == before)
	var fresh := CalendarData.new()
	assert(fresh.read(calendar.to_value()))
	assert(fresh.advance_day())
	assert(fresh.date.iso() == "2024-02-29")
	assert(fresh.delete_note(id))
	assert(fresh.notes_for("2024-02-28").is_empty())
	assert(fresh.notes_for("2024-02-29").size() == 1)
	assert(not fresh.read({"schema": 999, "date": "2024-02-28", "notes": []}))
	var implementation = load("res://rookframe/packages/aae579da-5392-4507-8eaa-0d918af58076/logic/implementation.gd").new()
	var invalid_rules := {"calendar_title": "Campaign", "calendar_type": "Custom", "month_names": ["Dawn", "Dusk"], "month_lengths": [30], "weekday_names": ["Sun", "Moon"]}
	assert(not implementation._rookframe_validate_settings(1, invalid_rules).is_empty(), "Custom calendar accepted mismatched month names and lengths")
	implementation.free()
	var SDK = load("res://rookframe/packages/aae579da-5392-4507-8eaa-0d918af58076/sdk/package_sdk_facade.gd")
	var Rules = load("res://rookframe/packages/aae579da-5392-4507-8eaa-0d918af58076/logic/calendar_rules.gd")
	var rules = Rules.new()
	rules.custom = true
	rules.month_names = SDK.TextList.new(["Dawn", "Dusk"])
	rules.month_lengths = SDK.IntegerList.new([3, 2])
	rules.weekday_names = SDK.TextList.new(["Sun", "Moon"])
	assert(date.read_iso("0001-01-04"))
	assert(rules.format_date(date) == "0001-02-01")
	assert(rules.format_date(date, true) == "Moon, 1 Dusk 0001")
	assert(rules.parse_date("0001-02-02").iso() == "0001-01-05")
	assert(rules.parse_date("0002-01-01").iso() == "0001-01-06")
	assert(rules.parse_date("0001-02-03") == null)
	var retained: Variant = calendar.to_value()
	var note_day = Date.new()
	assert(note_day.read_iso("2024-02-28"))
	assert(rules.parse_date(rules.format_date(note_day)).iso() == "2024-02-28")
	rules.month_lengths = SDK.IntegerList.new([5, 8])
	assert(rules.parse_date(rules.format_date(note_day)).iso() == "2024-02-28")
	assert(calendar.to_value() == retained)
	for boundary in ["0001-01-01", "1900-03-01", "2000-02-29", "2024-02-29", "9999-12-31"]:
		assert(date.read_iso(boundary))
		var copy := Date.new()
		assert(copy.read_day_index(date.day_index()))
		assert(copy.iso() == boundary)
	print("CALENDAR_DOMAIN PASS Gregorian boundaries / explicit start / note CRUD / retained interpretation")
	quit()
