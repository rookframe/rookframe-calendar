[&"", &"View date"]: [&"Datum anzeigen"],
[&"", &"Gregorian calendar · YYYY-MM-DD"]: [&"Gregorianischer Kalender · JJJJ-MM-TT"],
[&"", &"Note title"]: [&"Titel der Notiz"],
[&"", &"Note"]: [&"Notiz"],
[&"", &"Write a note for this date…"]: [&"Notiz für dieses Datum schreiben…"],
[&"", &"Set world date"]: [&"Weltdatum festlegen"],
[&"", &"Advance one day"]: [&"Einen Tag weiter"],
[&"", &"Dated notes"]: [&"Datierte Notizen"],
[&"", &"Save note"]: [&"Notiz speichern"],
[&"", &"Drafts stay here until you leave the World."]: [&"Entwürfe bleiben bis zum Verlassen der Welt erhalten."],
[&"", &"Untitled note"]: [&"Unbenannte Notiz"],
[&"", &"Draft"]: [&"Entwurf"],
