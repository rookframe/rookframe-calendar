[&"", &"This is the last supported date."]: [&"Dies ist das letzte unterstützte Datum."],
[&"", &"Viewing the next day. The World date is unchanged."]: [&"Nächster Tag. Das Weltdatum ist unverändert."],
[&"", &"This World cannot save Calendar changes yet. Your draft is still here."]: [&"Diese Welt kann Kalenderänderungen noch nicht speichern. Dein Entwurf bleibt erhalten."],
